# Optional: override the local data directory (database + vault).
# Default: ~/.sentinel
# SENTINEL_HOME=

# Optional: VirusTotal API key (hash-only lookups). Prefer storing this
# in the investigator vault as an api_key named "virustotal".
# VIRUSTOTAL_API_KEY=

# Vault auto-lock timeout in seconds (web API session).
# SENTINEL_VAULT_LOCK_SECONDS=300
